# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# local Supabase CLI state/secrets
/supabase/.temp/
/supabase/.branches/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: only public templates belong in git
.env*
!.env.example
/ops/outline/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
