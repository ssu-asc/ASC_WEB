# Browser-safe configuration only. Copy to .env.local and supply your project's public values.
# Leave blank until a Supabase project has been configured; the portal shows a setup notice.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional only for GitHub Pages deployments under a repository subpath.
NEXT_PUBLIC_BASE_PATH=
